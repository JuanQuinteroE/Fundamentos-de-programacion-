def f_factorial(numero):
    fac = 1
    i = 1
    while i <= numero:
        fac = fac * i
        i = i + 1
    return fac

# Principal
m = int(input("Ingrese un numero: "))
n = int(input("Ingrese un numero: "))

if m >= n and n >= 0:
    f1 = f_factorial(m)
    f2 = f_factorial(n)
    f3 = f_factorial(m - n)
    c = f1 / (f3 * f2)
    print(f"El combinatorio es: {c}")
else:
    c = 0
    print("El combinatorio es:", c)
